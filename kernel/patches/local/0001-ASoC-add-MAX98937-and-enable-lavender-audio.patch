+static void max98937_slot_config(struct i2c_client *i2c,
+	struct max98937_priv *max98937)
+{
+	int value;
+	struct device *dev = &i2c->dev;
+
+	if (!device_property_read_u32(dev, "vmon-slot-no", &value))
+		max98937->v_l_slot = value & 0xF;
+	else
+		max98937->v_l_slot = 0;
+
+	if (!device_property_read_u32(dev, "imon-slot-no", &value))
+		max98937->i_l_slot = value & 0xF;
+	else
+		max98937->i_l_slot = 1;
+}
+
+static int max98937_i2c_probe(struct i2c_client *i2c)
+{
+	int ret = 0, value;
+	int reg = 0;
+	struct max98937_priv *max98937 = NULL;
+
+	max98937 = devm_kzalloc(&i2c->dev, sizeof(*max98937), GFP_KERNEL);
+	if (!max98937)
+		return -ENOMEM;
+	i2c_set_clientdata(i2c, max98937);
+
+	/* update interleave mode info */
+	if (of_property_read_bool(i2c->dev.of_node, "maxim,interleave-mode")) {
+		max98937->interleave_mode = true;
+	} else {
+		if (!of_property_read_u32(i2c->dev.of_node, "interleave_mode",
+					  &value))
+			if (value > 0)
+				max98937->interleave_mode = true;
+	}
+
+	/* regmap initialization */
+	max98937->regmap = devm_regmap_init_i2c(i2c, &max98937_regmap);
+	if (IS_ERR(max98937->regmap)) {
+		ret = PTR_ERR(max98937->regmap);
+		dev_err(&i2c->dev,
+			"Failed to allocate regmap: %d\n", ret);
+		return ret;
+	}
+
+	max98937->reset_gpio = devm_gpiod_get_optional(&i2c->dev, "reset",
+						       GPIOD_OUT_HIGH);
+	if (IS_ERR(max98937->reset_gpio)) {
+		ret = PTR_ERR(max98937->reset_gpio);
+		return dev_err_probe(&i2c->dev, ret,
+				     "failed to request GPIO reset pin");
+	}
+
+	if (max98937->reset_gpio) {
+		gpiod_set_value_cansleep(max98937->reset_gpio, 0);
+		/* Wait for i2c port to be ready */
+		usleep_range(5000, 6000);
+	}
+
+	/* Check Revision ID (MAX98937 extended register space) */
+	ret = regmap_read(max98937->regmap, MAX98937_R0600_REV_ID, &reg);
+	if (ret < 0) {
+		dev_err(&i2c->dev,
+			"Failed to read: 0x%02X\n", MAX98937_R0600_REV_ID);
+		return ret;
+	}
+	dev_info(&i2c->dev, "MAX98937 revisionID: 0x%02X\n", reg);
+	if (!(reg & MAX98937_REV_ID_MASK))
+		dev_warn(&i2c->dev,
+			 "revision 0x%02X does not look like a MAX98937\n", reg);
+
+	/* voltage/current slot configuration */
+	max98937_slot_config(i2c, max98937);
+
+	/* codec registration */
+	ret = devm_snd_soc_register_component(&i2c->dev,
+		&soc_component_dev_max98937,
+		max98937_dai, ARRAY_SIZE(max98937_dai));
+	if (ret < 0)
+		dev_err(&i2c->dev, "Failed to register component: %d\n", ret);
+
+	return ret;
+}
+
+static void max98937_i2c_remove(struct i2c_client *i2c)
+{
+	struct max98937_priv *max98937 = i2c_get_clientdata(i2c);
+
+	if (max98937->reset_gpio)
+		gpiod_set_value_cansleep(max98937->reset_gpio, 1);
+}
+
+static const struct i2c_device_id max98937_i2c_id[] = {
+	{ .name = "max98937" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(i2c, max98937_i2c_id);
+
+#if defined(CONFIG_OF)
+static const struct of_device_id max98937_of_match[] = {
+	{ .compatible = "maxim,max98937" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, max98937_of_match);
+#endif
+
+#ifdef CONFIG_ACPI
+static const struct acpi_device_id max98937_acpi_match[] = {
+	{ "MX98937", 0 },
+	{},
+};
+MODULE_DEVICE_TABLE(acpi, max98937_acpi_match);
+#endif
+
+static struct i2c_driver max98937_i2c_driver = {
+	.driver = {
+		.name = "max98937",
+		.of_match_table = of_match_ptr(max98937_of_match),
+		.acpi_match_table = ACPI_PTR(max98937_acpi_match),
+	},
+	.probe = max98937_i2c_probe,
+	.remove = max98937_i2c_remove,
+	.id_table = max98937_i2c_id,
+};
+
+module_i2c_driver(max98937_i2c_driver)
+
+MODULE_DESCRIPTION("ALSA SoC MAX98937 driver");
+MODULE_AUTHOR("Ryan Lee <ryans.lee@maximintegrated.com>");
+MODULE_LICENSE("GPL");
