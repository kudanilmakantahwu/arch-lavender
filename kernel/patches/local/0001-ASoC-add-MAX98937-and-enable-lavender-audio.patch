+++ b/sound/soc/codecs/max98937.c
@@ -0,0 +1,757 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * max98937.c  --  MAX98937 ALSA SoC Audio driver
+ *
+ * Derived from max98927.c:
+ *   Copyright (C) 2016-2017 Maxim Integrated Products
+ *   Author: Ryan Lee <ryans.lee@maximintegrated.com>
+ *
+ * The MAX98937 is register-address compatible with the MAX98927 only for
+ * the interrupt/PCM-enable block.  The PCM format, sample-rate, speaker
+ * enable/gain and boost registers live at different addresses, so the
+ * MAX98927 driver silently programs the wrong registers on a MAX98937.
+ * This driver uses the MAX98937 map and the vendor-provided initialisation
+ * sequences.
+ */
+
+#include <linux/acpi.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <linux/gpio/consumer.h>
+#include <sound/tlv.h>
+#include "max98937.h"
+
+/*
+ * Initialisation sequence, taken from the vendor MAX98937 driver:
+ * first the per-channel map (single speaker, channel 0), then the common
+ * map.  Values are written verbatim; order matters.
+ */
+static const struct {
+	u16 reg;
+	u8 val;
+} max98937_init_seq[] = {
+	/* channel map */
+	{ MAX98937_R0040_BOOST_CTRL3,		0x01 },
+	{ MAX98937_R001E_PCM_TX_CH_SRC_A,	0x01 },
+	{ MAX98937_R0018_PCM_RX_EN_A,		0x03 },
+	{ MAX98937_R001A_PCM_TX_EN_A,		0x03 },
+	{ MAX98937_R001C_PCM_TX_HIZ_CTRL_A,	0xFC },
+	{ MAX98937_R0028_PCM_TO_SPK_MONOMIX_A,	0x80 },
+	{ MAX98937_R0029_PCM_TO_SPK_MONOMIX_B,	0x01 },
+
+	/* common map */
+	{ MAX98937_R0011_CLK_MON,		0x03 },
+	{ MAX98937_R0053_BROWNOUT_INFINITE_HOLD, 0x00 },
+	{ MAX98937_R0055_BROWNOUT_LVL_HOLD,	0x00 },
+	{ MAX98937_R005E_BROWNOUT_LVL1_CUR_LIMIT, 0x16 },
+	{ MAX98937_R005F_BROWNOUT_LVL1_AMP1_CTRL1, 0x00 },
+	{ MAX98937_R0060_BROWNOUT_LVL1_AMP1_CTRL2, 0x0c },
+	{ MAX98937_R0061_BROWNOUT_LVL1_AMP1_CTRL3, 0x0c },
+	{ MAX98937_R0062_BROWNOUT_LVL2_CUR_LIMIT, 0x12 },
+	{ MAX98937_R0063_BROWNOUT_LVL2_AMP1_CTRL1, 0x00 },
+	{ MAX98937_R0064_BROWNOUT_LVL2_AMP1_CTRL2, 0x0c },
+	{ MAX98937_R0065_BROWNOUT_LVL2_AMP1_CTRL3, 0x0c },
+	{ MAX98937_R0066_BROWNOUT_LVL3_CUR_LIMIT, 0x0e },
+	{ MAX98937_R0067_BROWNOUT_LVL3_AMP1_CTRL1, 0x03 },
+	{ MAX98937_R0068_BROWNOUT_LVL3_AMP1_CTRL2, 0x18 },
+	{ MAX98937_R0069_BROWNOUT_LVL3_AMP1_CTRL3, 0x18 },
+	{ MAX98937_R006A_BROWNOUT_LVL4_CUR_LIMIT, 0x0a },
+	{ MAX98937_R006B_BROWNOUT_LVL4_AMP1_CTRL1, 0x00 },
+	{ MAX98937_R006C_BROWNOUT_LVL4_AMP1_CTRL2, 0x80 },
+	{ MAX98937_R006D_BROWNOUT_LVL4_AMP1_CTRL3, 0x00 },
+	{ MAX98937_R005A_BROWNOUT_THRESH_HYSTERYSIS, 0x00 },
+	{ MAX98937_R005B_BROWNOUT_AMP_LIMITER_ATK_REL, 0x00 },
+	{ MAX98937_R005C_BROWNOUT_AMP_GAIN_ATK_REL, 0x1f },
+	{ MAX98937_R005D_BROWNOUT_AMP1_CLIP_MODE, 0x00 },
+	{ MAX98937_R0042_MEAS_ADC_CFG,		0x07 },
+	{ MAX98937_R0014_MEAS_ADC_THERM_WARN_THRESH, 0x75 },
+	{ MAX98937_R0015_MEAS_ADC_THERM_SHDN_THRESH, 0x8c },
+	{ MAX98937_R0016_MEAS_ADC_THERM_HYSTERESIS, 0x08 },
+	{ MAX98937_R0017_PIN_CFG,		0x55 },
+	{ MAX98937_R003E_MEAS_DSP_CFG,		0xF7 },
+	{ MAX98937_R0023_PCM_MODE_CFG,		0x40 },
+	{ MAX98937_R003A_SPK_SRC_SEL,		0x00 },
+	{ MAX98937_R001B_PCM_TX_EN_B,		0x00 },
+	{ MAX98937_R0019_PCM_RX_EN_B,		0x00 },
+	{ MAX98937_R001F_PCM_TX_CH_SRC_B,	0x03 },
+	{ MAX98937_R001D_PCM_TX_HIZ_CTRL_B,	0xFF },
+	{ MAX98937_R003D_MEAS_EN,		0x03 },
+	{ MAX98937_R0035_PDM_RX_CTRL,		0x00 },
+	{ MAX98937_R0036_AMP_VOL_CTRL,		0x38 },
+	{ MAX98937_R0037_AMP_DSP_CFG,		0x0f },
+	{ MAX98937_R003B_SPK_GAIN,		0x55 },
+	{ MAX98937_R003C_SSM_CFG,		0x85 },
+	{ MAX98937_R003F_BOOST_CTRL0,		0x1c },
+	{ MAX98937_R0041_BOOST_CTRL1,		0x40 },
+	{ MAX98937_R0043_MEAS_ADC_BASE_MSB,	0x00 },
+	{ MAX98937_R0044_MEAS_ADC_BASE_LSB,	0xFF },
+	{ MAX98937_R0073_ENV_TRACK_VOUT_HEADROOM, 0x0f },
+	{ MAX98937_R0077_ENV_TRACK_CTRL,	0x01 },
+	{ MAX98937_R0052_BROWNOUT_EN,		0x02 },
+	{ MAX98937_R0020_PCM_STATUS_WORD_CFG0,	0x00 },
+	{ MAX98937_R0021_PCM_STATUS_WORD_CFG1,	0x00 },
+	{ MAX98937_R0022_PCM_STATUS_WORD_CFG2,	0x00 },
+	{ MAX98937_R004E_SQUELCH,		0x10 },
+	{ MAX98937_R0079_BOOST_BYPASS_1,	0x45 },
+	{ MAX98937_R007A_BOOST_BYPASS_2,	0x2B },
+	{ MAX98937_R007B_BOOST_BYPASS_3,	0x04 },
+};
+
+static int max98937_apply_init_seq(struct max98937_priv *max98937)
+{
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(max98937_init_seq); i++) {
+		ret = regmap_write(max98937->regmap,
+				   max98937_init_seq[i].reg,
+				   max98937_init_seq[i].val);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int max98937_dai_set_fmt(struct snd_soc_dai *codec_dai, unsigned int fmt)
+{
+	struct snd_soc_component *component = codec_dai->component;
+	struct max98937_priv *max98937 = snd_soc_component_get_drvdata(component);
+	unsigned int mode = 0;
+	unsigned int format = 0;
+	bool use_pdm = false;
+	unsigned int invert = 0;
+
+	dev_dbg(component->dev, "%s: fmt 0x%08X\n", __func__, fmt);
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBC_CFC:
+		max98937->provider = false;
+		mode = MAX98937_PCM_MASTER_MODE_SLAVE;
+		break;
+	case SND_SOC_DAIFMT_CBP_CFP:
+		max98937->provider = true;
+		mode = MAX98937_PCM_MASTER_MODE_MASTER;
+		break;
+	default:
+		dev_err(component->dev, "DAI clock mode unsupported\n");
+		return -EINVAL;
+	}
+
+	regmap_update_bits(max98937->regmap, MAX98937_R0024_PCM_MASTER_MODE,
+			   MAX98937_PCM_MASTER_MODE_MASK, mode);
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		invert = MAX98937_PCM_MODE_CFG_PCM_BCLKEDGE;
+		break;
+	default:
+		dev_err(component->dev, "DAI invert mode unsupported\n");
+		return -EINVAL;
+	}
+
+	regmap_update_bits(max98937->regmap, MAX98937_R0023_PCM_MODE_CFG,
+			   MAX98937_PCM_MODE_CFG_PCM_BCLKEDGE, invert);
+
+	/* interface format */
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		format = MAX98937_PCM_FORMAT_I2S;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		format = MAX98937_PCM_FORMAT_LJ;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		format = MAX98937_PCM_FORMAT_TDM_MODE1;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		format = MAX98937_PCM_FORMAT_TDM_MODE0;
+		break;
+	case SND_SOC_DAIFMT_PDM:
+		use_pdm = true;
+		break;
+	default:
+		return -EINVAL;
+	}
+	max98937->iface = fmt & SND_SOC_DAIFMT_FORMAT_MASK;
+
+	if (!use_pdm) {
+		/* pcm channel configuration */
+		regmap_update_bits(max98937->regmap, MAX98937_R0018_PCM_RX_EN_A,
+				   MAX98937_PCM_RX_CH0_EN | MAX98937_PCM_RX_CH1_EN,
+				   MAX98937_PCM_RX_CH0_EN | MAX98937_PCM_RX_CH1_EN);
+
+		regmap_update_bits(max98937->regmap,
+				   MAX98937_R0023_PCM_MODE_CFG,
+				   MAX98937_PCM_MODE_CFG_FORMAT_MASK,
+				   format << MAX98937_PCM_MODE_CFG_FORMAT_SHIFT);
+
+		regmap_update_bits(max98937->regmap, MAX98937_R003A_SPK_SRC_SEL,
+				   MAX98937_SPK_SRC_MASK, 0);
+
+		regmap_update_bits(max98937->regmap, MAX98937_R0035_PDM_RX_CTRL,
+				   MAX98937_PDM_RX_EN_MASK, 0);
+	} else {
+		/* pdm channel configuration */
+		regmap_update_bits(max98937->regmap, MAX98937_R0035_PDM_RX_CTRL,
+				   MAX98937_PDM_RX_EN_MASK, 1);
+
+		regmap_update_bits(max98937->regmap, MAX98937_R003A_SPK_SRC_SEL,
+				   MAX98937_SPK_SRC_MASK, 3);
+
+		regmap_update_bits(max98937->regmap, MAX98937_R0018_PCM_RX_EN_A,
+				   MAX98937_PCM_RX_CH0_EN | MAX98937_PCM_RX_CH1_EN,
+				   0);
+	}
+	return 0;
+}
+
+/* codec MCLK rate in master mode */
+static const int rate_table[] = {
+	5644800, 6000000, 6144000, 6500000,
+	9600000, 11289600, 12000000, 12288000,
+	13000000, 19200000,
+};
+
+/* BCLKs per LRCLK */
+static const int bclk_sel_table[] = {
+	32, 48, 64, 96, 128, 192, 256, 384, 512,
+};
+
+static int max98937_get_bclk_sel(int bclk)
+{
+	int i;
+	/* match BCLKs per LRCLK */
+	for (i = 0; i < ARRAY_SIZE(bclk_sel_table); i++) {
+		if (bclk_sel_table[i] == bclk)
+			return i + 2;
+	}
+	return 0;
+}
+
+static int max98937_set_clock(struct max98937_priv *max98937,
+	struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_component *component = max98937->component;
+	/* BCLK/LRCLK ratio calculation */
+	int blr_clk_ratio = params_channels(params) * max98937->ch_size;
+	int value;
+
+	if (max98937->provider) {
+		int i;
+		/* match rate to closest value */
+		for (i = 0; i < ARRAY_SIZE(rate_table); i++) {
+			if (rate_table[i] >= max98937->sysclk)
+				break;
+		}
+		if (i == ARRAY_SIZE(rate_table)) {
+			dev_err(component->dev, "failed to find proper clock rate.\n");
+			return -EINVAL;
+		}
+		regmap_update_bits(max98937->regmap,
+				   MAX98937_R0024_PCM_MASTER_MODE,
+				   MAX98937_PCM_MASTER_MODE_MCLK_MASK,
+				   i << MAX98937_PCM_MASTER_MODE_MCLK_RATE_SHIFT);
+	}
+
+	if (!max98937->tdm_mode) {
+		/* BCLK configuration */
+		value = max98937_get_bclk_sel(blr_clk_ratio);
+		if (!value) {
+			dev_err(component->dev, "format unsupported %d\n",
+				params_format(params));
+			return -EINVAL;
+		}
+
+		regmap_update_bits(max98937->regmap,
+				   MAX98937_R0025_PCM_CLK_SETUP,
+				   MAX98937_PCM_CLK_SETUP_BSEL_MASK, value);
+	}
+	return 0;
+}
+
+static int max98937_dai_hw_params(struct snd_pcm_substream *substream,
+	struct snd_pcm_hw_params *params,
+	struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	struct max98937_priv *max98937 = snd_soc_component_get_drvdata(component);
+	unsigned int sampling_rate = 0;
+	unsigned int chan_sz = 0;
+
+	/* pcm mode configuration */
+	switch (snd_pcm_format_width(params_format(params))) {
+	case 16:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_16;
+		break;
+	case 24:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_24;
+		break;
+	case 32:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_32;
+		break;
+	default:
+		dev_err(component->dev, "format unsupported %d\n",
+			params_format(params));
+		goto err;
+	}
+
+	max98937->ch_size = snd_pcm_format_width(params_format(params));
+
+	regmap_update_bits(max98937->regmap, MAX98937_R0023_PCM_MODE_CFG,
+			   MAX98937_PCM_MODE_CFG_CHANSZ_MASK, chan_sz);
+
+	dev_dbg(component->dev, "format supported %d",
+		params_format(params));
+
+	/* sampling rate configuration */
+	switch (params_rate(params)) {
+	case 8000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_8000;
+		break;
+	case 11025:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_11025;
+		break;
+	case 12000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_12000;
+		break;
+	case 16000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_16000;
+		break;
+	case 22050:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_22050;
+		break;
+	case 24000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_24000;
+		break;
+	case 32000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_32000;
+		break;
+	case 44100:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_44100;
+		break;
+	case 48000:
+		sampling_rate = MAX98937_PCM_SR_SET1_SR_48000;
+		break;
+	default:
+		dev_err(component->dev, "rate %d not supported\n",
+			params_rate(params));
+		goto err;
+	}
+	/* set DAI_SR to correct LRCLK frequency */
+	regmap_update_bits(max98937->regmap, MAX98937_R0026_PCM_SR_SETUP1,
+			   MAX98937_PCM_SR_SET1_SR_MASK, sampling_rate);
+	regmap_update_bits(max98937->regmap, MAX98937_R0027_PCM_SR_SETUP2,
+			   MAX98937_PCM_SR_SET2_SR_MASK,
+			   sampling_rate << MAX98937_PCM_SR_SET2_SR_SHIFT);
+
+	/* set sampling rate of IV */
+	if (max98937->interleave_mode &&
+	    sampling_rate > MAX98937_PCM_SR_SET1_SR_16000)
+		regmap_update_bits(max98937->regmap,
+				   MAX98937_R0027_PCM_SR_SETUP2,
+				   MAX98937_PCM_SR_SET2_IVADC_SR_MASK,
+				   sampling_rate - 3);
+	else
+		regmap_update_bits(max98937->regmap,
+				   MAX98937_R0027_PCM_SR_SETUP2,
+				   MAX98937_PCM_SR_SET2_IVADC_SR_MASK,
+				   sampling_rate);
+	return max98937_set_clock(max98937, params);
+err:
+	return -EINVAL;
+}
+
+static int max98937_dai_tdm_slot(struct snd_soc_dai *dai,
+	unsigned int tx_mask, unsigned int rx_mask,
+	int slots, int slot_width)
+{
+	struct snd_soc_component *component = dai->component;
+	struct max98937_priv *max98937 = snd_soc_component_get_drvdata(component);
+	int bsel = 0;
+	unsigned int chan_sz = 0;
+
+	max98937->tdm_mode = true;
+
+	/* BCLK configuration */
+	bsel = max98937_get_bclk_sel(slots * slot_width);
+	if (bsel == 0) {
+		dev_err(component->dev, "BCLK %d not supported\n",
+			slots * slot_width);
+		return -EINVAL;
+	}
+
+	regmap_update_bits(max98937->regmap, MAX98937_R0025_PCM_CLK_SETUP,
+			   MAX98937_PCM_CLK_SETUP_BSEL_MASK, bsel);
+
+	/* Channel size configuration */
+	switch (slot_width) {
+	case 16:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_16;
+		break;
+	case 24:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_24;
+		break;
+	case 32:
+		chan_sz = MAX98937_PCM_MODE_CFG_CHANSZ_32;
+		break;
+	default:
+		dev_err(component->dev, "format unsupported %d\n",
+			slot_width);
+		return -EINVAL;
+	}
+
+	regmap_update_bits(max98937->regmap, MAX98937_R0023_PCM_MODE_CFG,
+			   MAX98937_PCM_MODE_CFG_CHANSZ_MASK, chan_sz);
+
+	/* Rx slot configuration */
+	regmap_write(max98937->regmap, MAX98937_R0018_PCM_RX_EN_A,
+		     rx_mask & 0xFF);
+	regmap_write(max98937->regmap, MAX98937_R0019_PCM_RX_EN_B,
+		     (rx_mask & 0xFF00) >> 8);
+
+	/* Tx slot configuration */
+	regmap_write(max98937->regmap, MAX98937_R001A_PCM_TX_EN_A,
+		     tx_mask & 0xFF);
+	regmap_write(max98937->regmap, MAX98937_R001B_PCM_TX_EN_B,
+		     (tx_mask & 0xFF00) >> 8);
+
+	/* Tx slot Hi-Z configuration */
+	regmap_write(max98937->regmap, MAX98937_R001C_PCM_TX_HIZ_CTRL_A,
+		     ~tx_mask & 0xFF);
+	regmap_write(max98937->regmap, MAX98937_R001D_PCM_TX_HIZ_CTRL_B,
+		     (~tx_mask & 0xFF00) >> 8);
+
+	return 0;
+}
