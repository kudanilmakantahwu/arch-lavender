+static int max98937_dac_event(struct snd_soc_dapm_widget *w,
+	struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct max98937_priv *max98937 = snd_soc_component_get_drvdata(component);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		max98937->tdm_mode = false;
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		/*
+		 * The MAX98937 keeps a separate global enable in the extended
+		 * register space (0x0500).  The part stays muted until it is
+		 * set, even with SPK_EN asserted.
+		 */
+		regmap_update_bits(max98937->regmap, MAX98937_R0039_AMP_ENABLES,
+				   MAX98937_AMP_EN_MASK, 1);
+		regmap_update_bits(max98937->regmap, MAX98937_R0500_GLOBAL_EN,
+				   MAX98937_GLOBAL_EN_MASK, 1);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_update_bits(max98937->regmap, MAX98937_R0500_GLOBAL_EN,
+				   MAX98937_GLOBAL_EN_MASK, 0);
+		regmap_update_bits(max98937->regmap, MAX98937_R0039_AMP_ENABLES,
+				   MAX98937_AMP_EN_MASK, 0);
+		break;
+	default:
+		return 0;
+	}
+	return 0;
+}
