[Unit]
Description=Phosh mobile shell on tty1
After=systemd-user-sessions.service systemd-logind.service NetworkManager.service seatd.service user@1000.service
Wants=systemd-logind.service user@1000.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=alarm
PAMName=login
TTYPath=/dev/tty1
WorkingDirectory=/home/alarm
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_CURRENT_DESKTOP=Phosh:GNOME
Environment=XDG_SESSION_DESKTOP=phosh
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_BACKENDS=drm,libinput
# Adreno 512: the GL (ngl) renderer is ~2.2x faster than cairo on text
# scrolling (51 fps vs 23 fps) and a 22 s scroll stress test showed no glyph
# corruption.  Fall back to cairo if glyphs go missing again.  /etc/environment
# sets the same value; PAM applies that on top of this unit.
Environment=GSK_RENDERER=ngl
# Adreno 512 UBWC compression corrupts Firefox/WebRender buffers, producing
# magenta blocks and blank surfaces.  Disable UBWC for the whole session.
Environment=FD_MESA_DEBUG=noubwc
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/user/1000/bus ] && exit 0; sleep 0.1; done; exit 0'
ExecStart=/usr/bin/phosh-session
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target