[Unit]
Description=Phosh mobile shell on tty1
After=systemd-user-sessions.service systemd-logind.service NetworkManager.service seatd.service user@1000.service
Wants=systemd-logind.service user@1000.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=alarm
PAMName=login
TTYPath=/dev/tty1
WorkingDirectory=/home/alarm
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_CURRENT_DESKTOP=Phosh:GNOME
Environment=XDG_SESSION_DESKTOP=phosh
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_BACKENDS=drm,libinput
# Adreno 512 / freedreno has a broken GTK4 NGL glyph cache: text loses
# random glyphs in headers and buttons.  Force the cairo renderer, the same
# workaround postmarketOS uses for Adreno 5xx.
Environment=GSK_RENDERER=cairo
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/user/1000/bus ] && exit 0; sleep 0.1; done; exit 0'
ExecStart=/usr/bin/phosh-session
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target