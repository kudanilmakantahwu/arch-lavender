#!/usr/bin/env python3
"""Translate two-finger pinch on the touchscreen into GNOME Console font zoom.

GNOME Console remembers its font scale in the org.gnome.Console GSettings
schema and applies it live to the VTE terminal, so adjusting that key gives
pinch-to-zoom in the terminal without needing keyboard events.

The daemon reads the multitouch touchscreen directly through evdev.  It never
grabs the device, so the compositor keeps receiving the same events.
"""

import math
import os
import select
import subprocess
import sys

from evdev import InputDevice, ecodes, list_devices

ENV = dict(os.environ)
ENV.setdefault("XDG_RUNTIME_DIR", "/run/user/1000")
ENV.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus")

MIN_SCALE = 0.7
MAX_SCALE = 2.5
STEP = 1.12
IN_RATIO = 1.18   # fingers spread by 18% -> one step bigger
OUT_RATIO = 0.85  # fingers pinched by 15% -> one step smaller


def log(msg):
    print(f"touch-zoom: {msg}", file=sys.stderr, flush=True)


def get_scale():
    try:
        out = subprocess.check_output(
            ["gsettings", "get", "org.gnome.Console", "font-scale"],
            env=ENV, text=True, timeout=2,
        )
        return float(out.strip())
    except Exception as exc:  # noqa: BLE001
        log(f"cannot read font-scale: {exc}")
        return 1.0


def set_scale(value):
    value = max(MIN_SCALE, min(MAX_SCALE, value))
    try:
        subprocess.run(
            ["gsettings", "set", "org.gnome.Console", "font-scale",
             f"{value:.2f}"],
            env=ENV, timeout=2, check=False,
        )
        log(f"font-scale -> {value:.2f}")
    except Exception as exc:  # noqa: BLE001
        log(f"cannot set font-scale: {exc}")
    return value


class PinchState:
    def __init__(self, dev):
        self.dev = dev
        self.slot = 0
        self.xy = {}          # slot -> [x, y]
        self.active = set()   # slots with a tracking id
        self.base = None

    def _distance(self):
        if len(self.xy) != 2:
            return None
        (x1, y1), (x2, y2) = list(self.xy.values())
        return math.hypot(x2 - x1, y2 - y1)

    def handle(self, ev, scale_box):
        code, value = ev.code, ev.value

        if ev.type == ecodes.EV_ABS:
            if code == ecodes.ABS_MT_SLOT:
                self.slot = value
            elif code == ecodes.ABS_MT_TRACKING_ID:
                if value == -1:
                    self.active.discard(self.slot)
                    self.xy.pop(self.slot, None)
                else:
                    self.active.add(self.slot)
                    self.xy.setdefault(self.slot, [0, 0])
            elif code == ecodes.ABS_MT_POSITION_X:
                self.xy.setdefault(self.slot, [0, 0])[0] = value
            elif code == ecodes.ABS_MT_POSITION_Y:
                self.xy.setdefault(self.slot, [0, 0])[1] = value
        elif ev.type == ecodes.EV_KEY and code == ecodes.BTN_TOUCH:
            if value == 0:
                self.xy.clear()
                self.active.clear()
                self.base = None
        elif ev.type == ecodes.EV_SYN and code == ecodes.SYN_REPORT:
            self._process(scale_box)

    def _process(self, scale_box):
        dist = self._distance()
        if dist is None or dist < 50:
            self.base = None
            return
        if self.base is None:
            self.base = dist
            return

        ratio = dist / self.base
        if ratio >= IN_RATIO:
            scale_box[0] = set_scale(scale_box[0] * STEP)
            self.base = dist
        elif ratio <= OUT_RATIO:
            scale_box[0] = set_scale(scale_box[0] / STEP)
            self.base = dist


def open_touchscreens(paths=None):
    devices = []
    for path in (paths or list_devices()):
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        caps = dev.capabilities(absinfo=False)
        abs_codes = set(caps.get(ecodes.EV_ABS, []))
        keys = set(caps.get(ecodes.EV_KEY, []))
        if (ecodes.ABS_MT_POSITION_X in abs_codes
                and ecodes.ABS_MT_POSITION_Y in abs_codes
                and ecodes.BTN_TOUCH in keys):
            log(f"watching {dev.path} ({dev.name})")
            devices.append(dev)
        else:
            dev.close()
    return devices


def run_daemon():
    paths = None
    if "--device" in sys.argv:
        idx = sys.argv.index("--device")
        paths = sys.argv[idx + 1:idx + 2]
    devices = open_touchscreens(paths)
    if not devices:
        log("no multitouch touchscreen found")
        return 1

    states = {dev.fd: (dev, PinchState(dev)) for dev in devices}
    scale_box = [get_scale()]

    while True:
        try:
            readable, _, _ = select.select(list(states), [], [], 5.0)
        except InterruptedError:
            continue
        for fd in readable:
            dev, state = states[fd]
            try:
                for ev in dev.read():
                    state.handle(ev, scale_box)
            except OSError:
                log(f"{dev.path} disappeared, exiting")
                return 1


def main():
    if "--zoom-in" in sys.argv:
        set_scale(get_scale() * STEP)
        return 0
    if "--zoom-out" in sys.argv:
        set_scale(get_scale() / STEP)
        return 0
    if "--status" in sys.argv:
        print(f"{get_scale():.2f}")
        return 0
    return run_daemon()


if __name__ == "__main__":
    sys.exit(main())