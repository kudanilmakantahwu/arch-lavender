# GTK4's NGL renderer loses glyphs on freedreno/Adreno 512 (random missing
# letters in headers and buttons).  The cairo renderer is slower but correct;
# postmarketOS applies the same workaround on Adreno 5xx devices.
GSK_RENDERER=cairo

# Adreno 512 UBWC (bandwidth compression) corrupts buffers shared between
# Firefox/WebRender and the compositor: pages render as magenta/red blocks or
# blank surfaces.  Disabling UBWC makes the GPU allocate plain tiled buffers
# and fixes third-party app rendering (postmarketOS does the same on a5xx).
FD_MESA_DEBUG=noubwc
